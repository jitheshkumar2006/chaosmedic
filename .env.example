# ChaosMedic Configuration

# LLM Configuration (Optional: Leave empty for deterministic DEMO MODE)
LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash
LLM_PROVIDER=google

# Service URLs
DEMO_APP_URL=http://localhost:8001
BACKEND_URL=http://localhost:8000

# Monitoring
HEALTH_CHECK_INTERVAL=3

# Sandbox
SANDBOX_TIMEOUT=30
SANDBOX_BASE_PORT=9000
